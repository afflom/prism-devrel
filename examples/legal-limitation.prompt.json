{
  "schema": "prism/prompt/1",
  "goal": "Tell whether a claim is still within its limitation period, so a matter can be triaged before anyone reads the file.",
  "app": {
    "name": "limitation-check",
    "title": "Limitation period",
    "purpose": "Decide whether a claim is timely, barred or needs a lawyer's review, from its kind, the years since it arose and whether the claimant was a minor.",
    "fields": [
      {
        "name": "claim",
        "kind": "choice",
        "values": [
          "contract",
          "tort",
          "property"
        ],
        "means": "the kind of claim"
      },
      {
        "name": "years",
        "kind": "number",
        "min": 0,
        "max": 100,
        "means": "whole years since the claim arose"
      },
      {
        "name": "minor",
        "kind": "choice",
        "values": [
          "yes",
          "no"
        ],
        "means": "whether the claimant was a minor when it arose"
      }
    ],
    "outcomes": [
      "timely",
      "barred",
      "review"
    ],
    "meanings": {
      "timely": "inside the period",
      "barred": "outside the period",
      "review": "a lawyer must look"
    },
    "rules": [
      {
        "when": [
          {
            "field": "minor",
            "op": "is",
            "value": "yes"
          }
        ],
        "then": "review",
        "why": "tolling for minors depends on the facts"
      },
      {
        "when": [
          {
            "field": "claim",
            "op": "is",
            "value": "contract"
          },
          {
            "field": "years",
            "op": "<",
            "value": 6
          }
        ],
        "then": "timely",
        "why": "six years for contract"
      },
      {
        "when": [
          {
            "field": "claim",
            "op": "is",
            "value": "tort"
          },
          {
            "field": "years",
            "op": "<",
            "value": 3
          }
        ],
        "then": "timely",
        "why": "three years for tort"
      },
      {
        "when": [
          {
            "field": "claim",
            "op": "is",
            "value": "property"
          },
          {
            "field": "years",
            "op": "<",
            "value": 12
          }
        ],
        "then": "timely",
        "why": "twelve years for property"
      },
      {
        "when": [
          {
            "field": "claim",
            "op": "is",
            "value": "tort"
          },
          {
            "field": "years",
            "op": "<",
            "value": 6
          }
        ],
        "then": "review",
        "why": "discoverability may extend a tort"
      }
    ],
    "otherwise": "barred",
    "otherwiseWhy": "past every period",
    "limits": [
      "The periods are illustrative, not the law of any one jurisdiction.",
      "It does not decide when a claim arose."
    ],
    "properties": [
      {
        "kind": "never",
        "when": [
          {
            "field": "minor",
            "op": "is",
            "value": "yes"
          }
        ],
        "then": "barred",
        "why": "a minor's claim is never barred without review"
      },
      {
        "kind": "always",
        "when": [
          {
            "field": "claim",
            "op": "is",
            "value": "contract"
          },
          {
            "field": "years",
            "op": "<",
            "value": 6
          },
          {
            "field": "minor",
            "op": "is",
            "value": "no"
          }
        ],
        "then": "timely",
        "why": "a recent contract claim is always timely"
      }
    ],
    "examples": [
      {
        "request": "contract 5 no",
        "response": "timely"
      },
      {
        "request": "contract 6 no",
        "response": "barred"
      },
      {
        "request": "tort 4 no",
        "response": "review"
      },
      {
        "request": "property 40 yes",
        "response": "review"
      },
      {
        "request": "tort 7 no",
        "response": "barred"
      }
    ]
  },
  "stakeholders": [
    {
      "name": "Lawyer",
      "text": "Triages matters and needs every barred answer to be one a review would not change.",
      "concerns": [
        "Correct answers",
        "Proved guarantees"
      ]
    },
    {
      "name": "Client",
      "text": "Brings a matter and needs a minor's claim never to be turned away without a review.",
      "concerns": [
        "Proved guarantees"
      ]
    }
  ],
  "axioms": {
    "inv001Holds": [
      "Classical.choice",
      "Quot.sound",
      "propext"
    ],
    "inv002Holds": [
      "Classical.choice",
      "Quot.sound",
      "propext"
    ]
  }
}
